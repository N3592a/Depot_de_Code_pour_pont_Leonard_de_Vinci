#include <Servo.h> 

  

// --- Broches --- 

const int trigPin1 = 2; 

const int echoPin1 = 3; 

const int trigPin2 = 4; 

const int echoPin2 = 5; 

const int ledPin = 6; 

const int servoPin = 9; 

  

// --- Logique --- 

const float SEUIL_DETECTION = 25.0; 

const float SEUIL_PRESENCE = 15.0; 

const unsigned long TIMEOUT_OUVERTURE = 30000; // 30 secondes 

  

Servo pontServo; 

  

enum EtatPont { FERME, OUVERT_ATTENTE_PASSAGE, EN_PASSAGE, SECURITE }; 

EtatPont etat = FERME; 

  

unsigned long tEtat = 0; // Temps d'entrée dans l'état 

  

// Anti-bruit : moyenne simple sur N mesures 

float mesurerDistanceCM(int trigPin, int echoPin) { 

  const int N = 3; 

  float val = 0; 

  for (int i=0; i<N; i++) { 

    digitalWrite(trigPin, LOW); delayMicroseconds(2); 

    digitalWrite(trigPin, HIGH); delayMicroseconds(10); 

    digitalWrite(trigPin, LOW); 

    long duration = pulseIn(echoPin, HIGH, 25000); 

    float d = duration == 0 ? 999.0 : (duration * 0.034) / 2.0; 

    val += d; 

    delay(20); 

  } 

  return val / N; 

} 

  

// Consignes pont 

void ouvrirPont()   { pontServo.write(90); } 

void fermerPont()   { pontServo.write(0);  } 

  

void alerteSecurite() { 

  Serial.println("!!! ERREUR CAPTEUR — Fermeture d'urgence et LED ON !!!"); 

  fermerPont(); 

  digitalWrite(ledPin, HIGH); 

  etat = SECURITE; 

} 

  

void setup() { 

  pinMode(trigPin1, OUTPUT); pinMode(echoPin1, INPUT); 

  pinMode(trigPin2, OUTPUT); pinMode(echoPin2, INPUT); 

  pinMode(ledPin, OUTPUT); digitalWrite(ledPin, LOW); 

  pontServo.attach(servoPin); 

  Serial.begin(9600); 

  

  fermerPont(); 

  Serial.println("SYSTEME PONT PRÊT"); 

} 

  

void loop() { 

  if(etat == SECURITE) return; // Attend reboot manuel 

  

  float d1 = mesurerDistanceCM(trigPin1, echoPin1); 

  float d2 = mesurerDistanceCM(trigPin2, echoPin2); 

  

  // Détection capteur hors service 

  if (d1 == 999 || d2 == 999) { 

    alerteSecurite(); 

    return; 

  } 

  

  // Fin du timeout dans n'importe quel état 

  if (etat != FERME && millis() - tEtat > TIMEOUT_OUVERTURE) { 

    Serial.println("Timeout sans passage détecté — fermeture sécurité."); 

    fermerPont(); digitalWrite(ledPin, LOW); 

    etat = FERME; 

    tEtat = millis(); 

    return; 

  } 

  

  switch(etat) { 

    case FERME: 

      if (d1 < SEUIL_DETECTION) { 

        Serial.println(">> Arrivée détectée, ouverture du pont."); 

        ouvrirPont(); digitalWrite(ledPin, HIGH); 

        etat = OUVERT_ATTENTE_PASSAGE; 

        tEtat = millis(); 

      } 

      break; 

  

    case OUVERT_ATTENTE_PASSAGE: 

      // Passage détecté sur capteur 2 : personne sur le pont 

      if (d2 < SEUIL_PRESENCE) { 

        Serial.println(">> Passage détecté."); 

        etat = EN_PASSAGE; 

        tEtat = millis(); // reset du timeout 

      } 

      break; 

  

    case EN_PASSAGE: 

      // Départ (plus personne sur le pont) 

      if (d2 > SEUIL_PRESENCE) { 

        Serial.println(">> Départ détecté, fermeture du pont."); 

        fermerPont(); digitalWrite(ledPin, LOW); 

        etat = FERME; 

        tEtat = millis(); 

      } 

      break; 

  

    default: break; 

  } 

  delay(250); 

} 
